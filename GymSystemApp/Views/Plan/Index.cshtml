@model IEnumerable<PlanViewModel>
@{
    ViewData["Title"] = "All Plans";
}
        <div class="container">
            <main role="main" class="pb-3">
                <div class="container">
                    
			@if (Model.Any() && Model is not null){
                            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                        @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

                @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                        @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }
                    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
                        <div>
                            <h2 class="text-primary-color mb-0">Membership Plans</h2>
                            <p class="text-muted">Manage your gym membership packages</p>
                        </div>
                    </header>
           

            
                <div class="row g-4">
				        @foreach (var plan in Model)
                        {
                             <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm border-0 plan-card">
                                <div class="card-header text-white text-center py-4 @(plan.IsActive ? "bg-primary-color" : "bg-secondary")">
                                    <h4 class="mb-0">@plan.Name</h4>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <div class="text-center mb-4">
                                        <div class="display-4 fw-bold text-primary-color">@plan.Price</div>
                                        <small class="text-muted">EGP</small>
                                    </div>

                                    <div class="mb-3">
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-calendar-check @(plan.IsActive ? "text-primary-color" : "text-secondary") me-2"></i>
                                            <strong>Duration:</strong> @plan.DurationDays
                                        </p>
                                        <p class="text-muted mb-3">
                                            <i class="bi bi-file-text @(plan.IsActive ? "text-primary-color" : "text-secondary") me-2"></i>
                                            <strong>Description:</strong> @plan.Description
                                        </p>
                                        <p class="small">Access to gym equipment during staffed hours</p>
                                    </div>

                                    <div class="mt-auto">
                                        <div class="d-grid gap-2">

                                            <a asp-action="Details" asp-route-id="@plan.Id" class="btn btn-outline btn-sm">
                                                <i class="bi bi-eye me-1"></i>View Details
                                            </a>

                                            <div class="d-flex gap-2">
                                                <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-outline btn-sm flex-fill">
                                                    <i class="bi bi-pencil me-1"></i>Edit
                                                </a>
                                                <form asp-action="@(plan.IsActive ? "Deactivate" : "Activate")" asp-route-id="@plan.Id" method="post" class="flex-fill">
                                                    <button type="submit" class="btn btn-outline btn-sm w-100 @(plan.IsActive ? "text-danger" : "text-success")">
                                                       @if (plan.IsActive)
                                                            {
                                                            <i class="bi bi-x-circle me-1"> Deactivate </i>
                                                            }
                                                            else
                                                            {
                                                            <i class="bi bi-check-circle me-1"> Activate </i>
                                                            }
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        }
                        </div>
            }
            else
            {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted"></i>
                        <h4 class="mt-3 text-muted">No Plans Available</h4>
                    </div>   
            }
            
        </div>
            </main>
        </div>

@section Scripts{
    <script>
        setTimeout(() => {
            let alerts =document.querySelectorAll('.alert');
        alerts.forEach(a=>a.remove());
        },3000);
   </script>

}