@model MemberToUpdateViewModel
@{
    ViewData["Title"] = "Update Member Details";
}
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card card-details border-0 p-2 shadow">
                        <div class="card-body text-center">
                            <div class="text-center mt-3">
                        <img src="@Url.Action("GetPhoto", "Member",new { fileName = @Model.Photo })" alt="@Model.Name" class="rounded-circle"
                                     style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #fff; margin-top: -60px;" />
                            </div>
                            <div class="card-body text-center">
                                <h2 class="mb-1 text-primary-color">@Model.Name</h2>
                                <form asp-controller="Member" asp-action="EditMember" method="post">
                                    <div class="mt-4 text-start">
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Email</small>
                                                    <input asp-for="@Model.Email" class="form-control" />
                                            <span asp-validation-for="@Model.Email" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Phone</small>
                                            <input asp-for="@Model.Phone" class="form-control" />
                                            <span asp-validation-for="@Model.Phone" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Building Number</small>
                                            <input asp-for="@Model.BuildingNumber" class="form-control" />
                                            <span asp-validation-for="@Model.BuildingNumber"
                                                          class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">City</small>
                                            <input asp-for="@Model.City" class="form-control" />
                                            <span asp-validation-for="@Model.City" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Street</small>
                                                    <input asp-for="@Model.Street" class="form-control" />
                                                    <span asp-validation-for="@Model.Street" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="d-flex justify-content-between gap-2 mt-3 px-3 pb-3">
                                        <a asp-controller="Member" asp-action="Index" class="btn btn-fill ">
                                            Back to
                                            List
                                        </a>
                                        <button type="submit" class="btn btn-fill ">Done</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
